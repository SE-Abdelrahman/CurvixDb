  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DatabaseScripts\Functions\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DatabaseScripts\Functions\fn_CalculatePatientAge.sql">
