    <None Update="DatabaseScripts\Functions\fn_ClassifyDeformitySeverity.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatabaseScripts\Functions\fn_GetAngleDifference.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatabaseScripts\Functions\fn_GetPatientAngleProgression.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatabaseScripts\Functions\fn_GetSpinalRegion.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatabaseScripts\Functions\fn_GetSubordinateUsers.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatabaseScripts\Functions\fn_IsExamReadyForReport.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
